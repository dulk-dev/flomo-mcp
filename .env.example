# MCP 入口钥匙。空值会拒绝启动。Agent 配置 Authorization: Bearer <这个值>
MCP_API_KEY=replace-with-a-long-random-string

# flomo 账密（服务端自己 login_by_email）。二选一：账密，或直接给 access_token
FLOMO_ACCOUNT=you@example.com
FLOMO_PASSWORD=your-password
# FLOMO_ACCESS_TOKEN=

# token.json / memos.json 目录，默认 ./data
# FLOMO_DATA_DIR=./data

# PORT=8787
# HOST=127.0.0.1
