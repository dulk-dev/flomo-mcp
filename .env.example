# flomo 账密（进程自己 login_by_email）。二选一：账密，或直接给 access_token
FLOMO_ACCOUNT=you@example.com
FLOMO_PASSWORD=your-password
# FLOMO_ACCESS_TOKEN=

# token.json / memos.json 目录。默认 /workspace/cache/flomo-cache
# FLOMO_DATA_DIR=/workspace/cache/flomo-cache

# 进程内再同步的间隔（毫秒）。默认 900000（15 分钟，与缓存新鲜窗口相同）。
# 到点后仍走新鲜窗口：未过期且已翻完则不打 flomo。设为 0 或 off 关闭。
# 启动时总会强制一轮，与这个间隔无关。读工具不会每次都强制同步。
# FLOMO_SYNC_INTERVAL_MS=900000
